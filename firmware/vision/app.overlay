#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>

/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};
};

&pinctrl {
	vision_uart0: vision_uart0 {
		group1 {
			pinmux = <UART0_TX_GPIO43>;
			output-high;
		};

		group2 {
			pinmux = <UART0_RX_GPIO44>;
			bias-pull-up;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&vision_uart0>;
	pinctrl-names = "default";
};

/delete-node/ &ov2640;

&i2c1 {
	ov3660: ov3660@3c {
		compatible = "ovti,ov3660";
		reg = <0x3c>;

		port {
			ov3660_ep_out: endpoint {
				remote-endpoint = <&dvp_ep_in>;
			};
		};
	};
};

&lcd_cam_dvp {
	cam-clk = <20000000>;
	source = <&ov3660>;
	invert-vsync;
};

&dvp_ep_in {
	remote-endpoint = <&ov3660_ep_out>;
};
